# Copie para .env e preencha com os valores reais. Não versione o .env.
# Na Vercel, cadastre as variáveis em Settings → Environment Variables.
# Só as variáveis NEXT_PUBLIC_* chegam ao navegador; as demais ficam no servidor.

# ---------- Aplicativo (Portal Perfin) — Vercel ----------
# URL pública do app na Vercel (sem barra no final)
NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Secret key (Supabase → Project Settings → API Keys). Só servidor.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Google OAuth (o mesmo client cadastrado no provedor Google do Supabase)
GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Domínio Google Workspace autorizado para usuários
ALLOWED_GOOGLE_DOMAIN=perfin.com.br

# E-mail do administrador (a senha fica só no Supabase Auth, com MFA)
ADMIN_USER=admin@exemplo.com.br

# Gemini
GEMINI_API_KEY=xxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-flash-latest

# Chave de 32 bytes em base64 para cifrar tokens do Google
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# Protege as rotas chamadas pelo Vercel Cron
CRON_SECRET=xxxxxxxxxxxxxxxx

# Token do GitHub (fine-grained, só Actions: read/write neste repositório) — botão "coletar agora"
GITHUB_ACTIONS_TOKEN=github_pat_xxxxxxxxxxxxxxxx
GITHUB_REPO=usuario/repositorio

# ---------- Coleta de indicadores (GitHub Actions secret) ----------
# String do Session pooler do Supabase com o papel etl_indicadores
INDICADORES_DATABASE_URL=postgresql://etl_indicadores.seu-projeto:sua-senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---------- Somente local (migrations) — não vão para a Vercel ----------
SUPABASE_DB_PASSWORD=sua-senha
DATABASE_URL=postgresql://postgres:sua-senha@db.seu-projeto.supabase.co:5432/postgres
GITHUB_REPO_URL=https://github.com/usuario/repositorio

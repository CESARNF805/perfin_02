.claude/settings.local.json
.claude/*.local.*

# Variáveis de ambiente (segredos) — nunca versionar
.env
.env.*
!.env.example
# Anotações locais com segredos — nunca versionar (o ideal é nem ficar na pasta)
Dados Perfin.txt

